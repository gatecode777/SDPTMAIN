# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/E-commerce

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET=your_super_secret_key_here_32_chars
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your_super_secret_key_here_32_chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Cloudinary Storage Configuration (For Product & Profile Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (For Order Invoices, OTPs, & Query Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_SECURE=false
